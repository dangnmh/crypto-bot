# MEXC API Credentials (set via env or Bitwarden Secrets Manager)
# If env vars are empty and Bitwarden config is present, credentials will be fetched from Bitwarden
MEXC_API_KEY=
MEXC_API_SECRET=
TELEGRAM_BOT_TOKEN=
# Bitwarden Secrets Manager (optional - used as fallback for MEXC credentials)
# See docs/README_BITWARDEN.md for setup instructions
BITWARDEN_ACCESS_TOKEN=
BITWARDEN_ORGANIZATION_ID=
BITWARDEN_PROJECT_NAME=
