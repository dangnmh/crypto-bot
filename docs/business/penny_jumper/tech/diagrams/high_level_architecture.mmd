flowchart TD
    subgraph Exchange["☁️ MEXC Exchange"]
        REST_API["REST API"]
        WS_API["WebSocket API"]
    end

    subgraph Bot["🤖 Penny Jumper Bot — Isolated"]

        subgraph BG["📡 Background Data Jobs"]
            BG_TICKER["🔄 Ticker24h Job\n(every N min)"]
            BG_CONTRACT["🔄 Contract Job\n(every N min)"]
        end

        subgraph SUB["🔍 Subscribe Manager"]
            FILTER["Filter: Vol24h >= nM"]
            SUB_MGR["Sub/Unsub WS pairs\n⚠️ Skip if workflow active"]
        end

        subgraph STORE["💾 Local Store"]
            S_TICKER[("TickerStore")]
            S_CONTRACT[("ContractStore")]
            S_DEPTH[("DepthStore\n20 levels/pair")]
            S_WALL[("WallHistoryStore")]
        end

        subgraph PIPELINE["⚡ Event Pipeline (4 stages)"]
            OB_BUILDER["1️⃣ OB Builder\nParse raw L2\nWrite DepthStore"]
            W_DETECTOR["2️⃣ Wall Detector\nDetect + Track walls\nEmit wall events"]
            W_SCORER["3️⃣ Wall Scorer\n6 factors + penalty"]
            WF_MGR["4️⃣ Workflow Manager\nHasActive? MaxPos?\nSpawn FSM"]
        end

        subgraph WORKFLOWS["⚙️ Active Workflows"]
            FSM_1["FSM: COIN_A"]
            FSM_2["FSM: COIN_B"]
            FSM_N["FSM: ..."]
        end

        subgraph EXEC["🎯 Execution"]
            ORDER_MGR["Order Manager\nPriority Queue"]
            RISK_MGR["Risk Manager"]
            ORDER_WATCH["Order Watcher"]
        end
    end

    %% Background Jobs
    REST_API -.-> BG_TICKER & BG_CONTRACT
    BG_TICKER --> S_TICKER
    BG_CONTRACT --> S_CONTRACT
    BG_TICKER -->|"trigger"| FILTER
    S_TICKER -.-> FILTER
    FILTER --> SUB_MGR

    %% WS Layer
    SUB_MGR -->|"sub/unsub"| WS_API
    WS_API ==>|"depth.step0"| OB_BUILDER

    %% Event Pipeline (core flow)
    OB_BUILDER -->|"write"| S_DEPTH
    OB_BUILDER -->|"📨 DepthUpdated"| W_DETECTOR
    W_DETECTOR -.->|"read"| S_WALL
    W_DETECTOR -->|"📨 WallDetected"| W_SCORER
    W_SCORER -->|"📨 WallQualified\nscore >= 65"| WF_MGR
    WF_MGR -->|"spawn goroutine"| FSM_1 & FSM_2 & FSM_N

    %% Wall events direct to FSMs
    W_DETECTOR -->|"📨 WallChanged\n📨 WallDisappeared"| FSM_1 & FSM_2 & FSM_N

    %% Execution
    FSM_1 & FSM_2 & FSM_N <-->|"Place/Cancel"| ORDER_MGR
    ORDER_MGR <-->|"Private API"| REST_API
    FSM_1 & FSM_2 & FSM_N --> RISK_MGR
    WS_API -.->|"push.personal.order"| ORDER_WATCH
    ORDER_WATCH -->|"📨 OrderFilled"| FSM_1 & FSM_2 & FSM_N

    %% Styles
    style BG fill:#1a1a2e,stroke:#e94560,color:#fff
    style STORE fill:#0f3460,stroke:#16213e,color:#fff
    style PIPELINE fill:#533483,stroke:#e94560,color:#fff
    style WORKFLOWS fill:#005c2a,stroke:#e94560,color:#fff
    style EXEC fill:#16213e,stroke:#0f3460,color:#fff
