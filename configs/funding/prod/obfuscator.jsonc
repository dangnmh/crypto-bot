{
  // Order Obfuscator Configuration (Production Environment)
  // Master toggle to enable or disable background obfuscation
  "enabled": false,
  // Interval between database scans for profitable trades
  "pollInterval": "15m",
  // Jitter duration added/subtracted randomly to pollInterval (e.g. 2m -> [13m, 17m])
  "jitter": "2m",
  // Lookback window for querying historical trades (created_at >= now - lookbackWindow)
  "lookbackWindow": "24h",
  // Exchange-specific obfuscation settings
  "exchanges": {
    "toobit_futures": {
      // Enable obfuscation for this specific exchange
      "enabled": false,
      // Minimum Net Funding Profit (USDT) of a symbol required to activate loss budget obfuscation
      "netPnLThresholdUSDT": 20.0,
      // Minimum notional order size in USD (floor)
      "minNotionalUSD": 100.0,
      // Maximum notional order size in USD (ceiling)
      "maxNotionalUSD": 2000.0,
      // Real USDT collateral/margin allocated per position
      "marginUSDT": 200.0,
      // Leverage (e.g. 2, 5, 10). If 0 or omitted, leverage is dynamically computed as ceil(notional / margin)
      "leverage": 10,
      // Target Take Profit %
      "takeProfitPct": 0.5,
      // Safety Stop Loss %
      "stopLossPct": 0.5,
      // Maximum price difference % allowed for IOC order slippage tolerance (e.g. 0.5 = 0.5%)
      "maxPriceDiffPercent": 0.5,
      // Minimum holding duration in seconds before closing position
      "minHoldSec": 10,
      // Maximum holding duration in seconds (hold time is randomly chosen between min and max)
      "maxHoldSec": 60,
      // Maximum number of active obfuscation orders to trigger per scan cycle
      "maxActiveOrders": 2,
      // % of funding profit to sacrifice as intentional loss per symbol (e.g. 50.0 = 50%)
      "sacrificeLossPct": 35.0,
      // Safety cap on maximum total loss in USD per symbol per day
      "maxDailyLossUSD": 400.0
    }
  }
}