{
  // Funding Reversion (Dao chieu sau Funding)
  "enabled": true,
  "openType": "ISOLATED",
  "positionMode": "HEDGE",
  "default": {
    "takeProfitPct": 1,
    "stopLossPct": 2,
    "bufferTime": "-150ms",
    "postSettleTimeout": "1s",
    "leverage": 6,
    "marginUSD": 5,
    "minVol24USD": 10000000,
    "minFundingRate": 0.8
  },
  "sync": {
    "time": "60s",
    "ticker": "300s",
    "contract": "3600s",
    "funding": "30s"
  },
  "safety": {
    "maxImpactRatio": 5,
    "maxLatency": "400ms", // Abort if RTT > 400ms
    "maxPriceDiffPercent": 0.8,
    "maxSymbolUSDTPrice": 50
  },
  "notifier": {
    "enable": true
  },
  "scanners": {
    "configured": false,
    "schedule": {
      "mexc": true,
      "binance": true,
      "bybit": true,
      "kucoin": true,
      "okx": true,
      "gate": true
    }
  },
  "exchanges": {
    "mexc": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "-150ms", // Fire at T - (Latency/2 + Buffer) the bigger the earlier
      "postSettleTimeout": "1s" // Force close if reversion lifecycle does not terminally close
    },
    "bybit": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "-200ms",
      "postSettleTimeout": "1s"
    },
    "binance": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "-250ms",
      "postSettleTimeout": "1s"
    },
    "kucoin": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "-400ms",
      "postSettleTimeout": "1s"
    },
    "okx": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "0ms",
      "postSettleTimeout": "1s",
      "minVol24USD": 1000000,
      "minFundingRate": 0.3
    },
    "gate": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "-100ms",
      "postSettleTimeout": "1s"
    },
    "hyperliquid": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "30ms",
      "postSettleTimeout": "1s"
    },
    "bitget": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "30ms",
      "postSettleTimeout": "1s"
    },
    "bingx": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "30ms",
      "postSettleTimeout": "1s"
    },
    "deepcoin": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "-200ms",
      "postSettleTimeout": "1s"
    }
  }
  // Reversion exit is intentionally static: IOC entry with server-side TP/SL.
  // No dynamic pricing, orderbook wall cap, imbalance filter, or trailing stop.
}