{
  // Funding Reversion (Dao chieu sau Funding)
  "enabled": true,
  "openType": "ISOLATED",
  "positionMode": "HEDGE",
  "tradeSide": "short",
  "default": {
    "takeProfitPct": 1,
    "stopLossPct": 2,
    "bufferTime": "-150ms",
    "postSettleTimeout": "0.5s",
    "leverage": 6,
    "marginUSD": 5,
    "minVol24USD": 5000000,
    "minFundingRate": 0.8,
    "maxCandidateTrade": 1
  },
  "sync": {
    "time": "60s",
    "ticker": "300s",
    "contract": "3600s",
    "funding": "30s"
  },
  "safety": {
    "maxImpactRatio": 5,
    "maxLatency": "400ms", // Abort if RTT > 400ms
    "maxPriceDiffPercent": 0.8,
    "maxSymbolUSDTPrice": 50
  },
  "notifier": {
    "enable": true
  },
  "scanners": {
    "configured": false,
    "schedule": {
      "mexc": true,
      "binance": true,
      "bybit": true,
      "kucoin": false, // negative pnl
      "okx": true,
      "gate": true,
      "toobit": true,
      "bitmart": false, // negative pnl
      "weex": true,
      "bitunix": false, // exchange restricted
      "xt": false, // negative pnl
      "orangex": true
    }
  },
  "exchanges": {
    "mexc": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "-70ms", // -100ms dont paid funding fee Fire at T - (Latency/2 + Buffer) the bigger the earlier
      "postSettleTimeout": "0.5s", // Force close if reversion lifecycle does not terminally close
      "minVol24USD": 10000000,
      "minFundingRate": 0.8,
      "leverage": 2,
      "marginUSD": 100,
      "maxCandidateTrade": 1
    },
    "bybit": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "-150ms",
      "postSettleTimeout": "0.5s"
    },
    "binance": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "-200ms", // -200ms fill bad price -150ms paid funding fee
      "postSettleTimeout": "0.5s"
    },
    "kucoin": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "-250ms", // -200ms paid funding fee
      "postSettleTimeout": "0.5s"
    },
    "okx": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "0ms",
      "postSettleTimeout": "0.5s",
      "minVol24USD": 1000000,
      "minFundingRate": 0.3
    },
    "gate": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "-150ms",
      "postSettleTimeout": "0.5s"
    },
    "toobit": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "450ms", // 500ms paid funding fee
      "postSettleTimeout": "0.5s",
      "minVol24USD": 10000000,
      "minFundingRate": 0.8,
      "leverage": 20,
      "marginUSD": 550,
      "maxCandidateTrade": 3
    },
    "bitmart": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "-100ms", // -50ms paid funding fee
      "postSettleTimeout": "0.5s",
      "minVol24USD": 1000000,
      "minFundingRate": 0.3,
      "leverage": 3,
      "marginUSD": 5
    },
    "weex": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "100ms",
      "postSettleTimeout": "0.5s",
      "minVol24USD": 1000000,
      "minFundingRate": 0.3,
      "leverage": 3,
      "marginUSD": 5
    },
    "bitunix": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "250ms", // 200ms dont get funding fee 300ms paid funding fee
      "postSettleTimeout": "0.5s"
    },
    "xt": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "-550ms", // -500ms paid funding fee
      "postSettleTimeout": "0.5s",
      "minVol24USD": 1000000,
      "minFundingRate": 0.3,
      "leverage": 3,
      "marginUSD": 5
    },
    "orangex": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "100ms", // 0ms dont paid funding fee
      "postSettleTimeout": "0.5s",
      "minVol24USD": 1000000,
      "minFundingRate": 0.3,
      "leverage": 3,
      "marginUSD": 5
    }
  }
  // Reversion exit is intentionally static: IOC entry with server-side TP/SL.
  // No dynamic pricing, orderbook wall cap, imbalance filter, or trailing stop.
}