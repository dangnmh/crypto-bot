{
  // Funding Reversion (Dao chieu sau Funding)
  "enabled": true,
  "openType": "ISOLATED",
  "positionMode": "HEDGE",
  "tradeSide": "short",
  "default": {
    "takeProfitPct": 1,
    "stopLossPct": 2,
    "bufferTime": "-150ms",
    "postSettleTimeout": "0.5s",
    "leverage": 6,
    "marginUSD": 5,
    "minVol24USD": 5000000,
    "minFundingRate": 0.7,
    "maxCandidateTrade": 1
  },
  "sync": {
    "time": "60s",
    "ticker": "300s",
    "contract": "3600s",
    "funding": "30s"
  },
  "safety": {
    "maxImpactRatio": 5,
    "maxLatency": "400ms", // Abort if RTT > 400ms
    "maxPriceDiffPercent": 0.8,
    "maxSymbolUSDTPrice": 50
  },
  "notifier": {
    "enable": true
  },
  "scanners": {
    "configured": false,
    "schedule": {
      "toobit": true,
      "mexc": true,
      "bitget": true,
      "aster": true,
      "deepcoin": true,
      "kucoin": false, // negative pnl
      "bitmart": false, // negative pnl
      "bitunix": false, // exchange restricted
      "okx": false, // no funding oppotunity
      "xt": false, // negative pnl
      "gate": false, // rare oppotunity, negative pnl,
      "binance": false, // negative pnl,
      "orangex": false, // negative pnl,
      "bybit": false, // very high cancel rate,
      "hotcoin": false, // prevent trade at funding settle
      "weex": false, // no funding oppotunity
    }
  },
  "exchanges": {
    "toobit": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "350ms", // 400ms paid funding fee
      "postSettleTimeout": "0.5s",
      "minVol24USD": 10000000,
      "minFundingRate": 0.7,
      "leverage": 18,
      "marginUSD": 700,
      "maxCandidateTrade": 3
    },
    "mexc": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "-70ms", // -100ms dont paid funding fee Fire at T - (Latency/2 + Buffer) the bigger the earlier
      "postSettleTimeout": "0.5s", // Force close if reversion lifecycle does not terminally close
      "minFundingRate": 0.7,
      "leverage": 10,
      "marginUSD": 150,
    },
    "bitget": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "-270ms", // -250ms paid funding fee
      "postSettleTimeout": "0.5s",
      "minFundingRate": 0.7,
      "leverage": 10,
      "marginUSD": 50
    },
    "deepcoin": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "-20ms", // 0ms paid funding fee
      "postSettleTimeout": "0.5s",
      "minFundingRate": 0.7,
      "leverage": 10,
      "marginUSD": 50
    },
    "aster": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "-80ms", // -50ms paid funding fee
      "postSettleTimeout": "0.5s",
      "minVol24USD": 2000000,
      "minFundingRate": 0.7,
      "leverage": 2,
      "marginUSD": 50
    },
    "bybit": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "0ms", // 0ms high cancel rate 50ms paid funding fee
      "postSettleTimeout": "0.5s"
    },
    "binance": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "-200ms", // -200ms fill bad price -150ms paid funding fee
      "postSettleTimeout": "0.5s"
    },
    "kucoin": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "-250ms", // -200ms paid funding fee
      "postSettleTimeout": "0.5s"
    },
    "okx": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "0ms",
      "postSettleTimeout": "0.5s",
      "minVol24USD": 1000000,
      "minFundingRate": 0.3
    },
    "gate": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "-150ms",
      "postSettleTimeout": "0.5s"
    },
    "bitmart": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "-100ms", // -50ms paid funding fee
      "postSettleTimeout": "0.5s",
      "minVol24USD": 1000000,
      "minFundingRate": 0.3,
      "leverage": 3,
      "marginUSD": 5
    },
    "weex": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "-200ms", // -150ms paid funding fee
      "postSettleTimeout": "0.5s",
      "minVol24USD": 1000000,
      "minFundingRate": 0.3,
      "leverage": 3,
      "marginUSD": 5
    },
    "bitunix": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "250ms", // 200ms dont get funding fee 300ms paid funding fee
      "postSettleTimeout": "0.5s"
    },
    "xt": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "-550ms", // -500ms paid funding fee
      "postSettleTimeout": "0.5s",
      "minVol24USD": 1000000,
      "minFundingRate": 0.3,
      "leverage": 3,
      "marginUSD": 5
    },
    "orangex": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "300ms", // 100ms dont paid funding fee, 250ms cancel high cancel rate
      "postSettleTimeout": "0.5s",
      "minVol24USD": 1000000,
      "minFundingRate": 0.3,
      "leverage": 3,
      "marginUSD": 5
    },
    "hotcoin": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "0ms",
      "postSettleTimeout": "0.5s",
      "minVol24USD": 1000000,
      "minFundingRate": 0.3,
      "leverage": 8,
      "marginUSD": 5
    }
  }
  // Reversion exit is intentionally static: IOC entry with server-side TP/SL.
  // No dynamic pricing, orderbook wall cap, imbalance filter, or trailing stop.
}