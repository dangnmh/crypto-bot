{
  // Funding Reversion (Dao chieu sau Funding)
  "enabled": true,
  "openType": "ISOLATED",
  "positionMode": "HEDGE",
  "tradeSide": "short",
  "default": {
    "useOrderManager": true,
    "takeProfitPct": 1,
    "stopLossPct": 2,
    "bufferTime": "-150ms",
    "postSettleTimeout": "0.5s",
    "leverage": 6,
    "marginUSD": 5,
    "minVol24USD": 5000000,
    "minFundingRate": 0.7,
    "maxCandidateTrade": 1,
    "maxMarginUSDOfCandidate": 1000,
    "scoringRateWeight": 1.0, // Points per 0.1% (0.001) absolute funding rate
    "scoringVolumeWeight": 0.5, // Points per 1M USDT 24h volume
    "maxVolumeScore": 10.0 // Max volume score cap (10.0 pts = equivalent of 20M USDT volume cap)
  },
  "sync": {
    "time": "60s",
    "ticker": "300s",
    "contract": "3600s",
    "funding": "30s"
  },
  "safety": {
    "maxImpactRatio": 200,
    "maxLatency": "400ms", // Abort if RTT > 400ms
    "maxPriceDiffPercent": 0.8,
    "maxSymbolUSDTPrice": 100
  },
  "notifier": {
    "enable": true
  },
  "statsReporter": {
    "enable": true
  },
  "priceTracker": {
    "enable": true
  },
  "scanners": {
    "configured": false,
    "schedule": {
      "toobit_futures": true,
      "mexc_futures": true,
      "bitget_futures": false, // negative pnl
      "deepcoin_futures": false, // exchange restricted
      "kucoin_futures": false, // negative pnl
      "bitmart_futures": false, // negative pnl
      "bitunix_futures": false, // exchange restricted
      "okx_futures": false, // no funding oppotunity
      "xt_futures": false, // negative pnl
      "gate_futures": false, // rare oppotunity, negative pnl,
      "binance_futures": false, // negative pnl,
      "orangex_futures": false, // negative pnl,
      "bybit_futures": false, // very high cancel rate,
      "hotcoin_futures": false, // prevent trade at funding settle
      "weex_futures": false, // no funding oppotunity
      "aster_futures": false // negative pnl
    }
  },
  "exchanges": {
    "toobit_futures": {
      "takeProfitPct": 1.5,
      "stopLossPct": 2,
      // Fire at T - (Latency/2 + Buffer) the bigger the earlier
      "bufferTime": "390ms", // 350ms dont paid funding fee, 400ms paid funding fee
      "postSettleTimeout": "0.5s",
      "minVol24USD": 7000000,
      "minFundingRate": 0.6,
      "leverage": 20,
      "marginUSD": 1200,
      "maxCandidateTrade": 3
    },
    "mexc_futures": {
      "takeProfitPct": 1.5,
      "stopLossPct": 2,
      "bufferTime": "-60ms", // -70ms.-60ms dont paid funding fee, -50 paid funding fee
      "postSettleTimeout": "0.5s", // Force close if reversion lifecycle does not terminally close
      "minVol24USD": 7000000,
      "minFundingRate": 0.6,
      "leverage": 10,
      "marginUSD": 400
    },
    "bitget_futures": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "-320ms", // -300ms paid funding fee
      "postSettleTimeout": "0.5s",
      "minFundingRate": 0.7,
      "leverage": 10,
      "marginUSD": 50
    },
    "deepcoin_futures": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "-20ms", // 0ms paid funding fee
      "postSettleTimeout": "0.5s",
      "minFundingRate": 0.7,
      "leverage": 20,
      "marginUSD": 100
    },
    "aster_futures": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "-80ms", // -50ms paid funding fee
      "postSettleTimeout": "0.5s",
      "minVol24USD": 2000000,
      "minFundingRate": 0.7,
      "leverage": 2,
      "marginUSD": 50
    },
    "bybit_futures": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "0ms", // 0ms high cancel rate 50ms paid funding fee
      "postSettleTimeout": "0.5s"
    },
    "binance_futures": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "-200ms", // -200ms fill bad price -150ms paid funding fee
      "postSettleTimeout": "0.5s"
    },
    "kucoin_futures": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "-250ms", // -200ms paid funding fee
      "postSettleTimeout": "0.5s"
    },
    "okx_futures": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "0ms",
      "postSettleTimeout": "0.5s",
      "minVol24USD": 1000000,
      "minFundingRate": 0.3
    },
    "gate_futures": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "-150ms",
      "postSettleTimeout": "0.5s"
    },
    "bitmart_futures": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "-100ms", // -50ms paid funding fee
      "postSettleTimeout": "0.5s",
      "minVol24USD": 1000000,
      "minFundingRate": 0.3,
      "leverage": 3,
      "marginUSD": 5
    },
    "weex_futures": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "-200ms", // -150ms paid funding fee
      "postSettleTimeout": "0.5s",
      "minVol24USD": 1000000,
      "minFundingRate": 0.3,
      "leverage": 3,
      "marginUSD": 5
    },
    "bitunix_futures": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "250ms", // 200ms dont get funding fee 300ms paid funding fee
      "postSettleTimeout": "0.5s"
    },
    "xt_futures": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "-550ms", // -500ms paid funding fee
      "postSettleTimeout": "0.5s",
      "minVol24USD": 1000000,
      "minFundingRate": 0.3,
      "leverage": 3,
      "marginUSD": 5
    },
    "orangex_futures": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "300ms", // 100ms dont paid funding fee, 250ms cancel high cancel rate
      "postSettleTimeout": "0.5s",
      "minVol24USD": 1000000,
      "minFundingRate": 0.3,
      "leverage": 3,
      "marginUSD": 5
    },
    "hotcoin_futures": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "0ms",
      "postSettleTimeout": "0.5s",
      "minVol24USD": 1000000,
      "minFundingRate": 0.3,
      "leverage": 8,
      "marginUSD": 5
    }
  }
  // Reversion exit is intentionally static: IOC entry with server-side TP/SL.
  // No dynamic pricing, orderbook wall cap, imbalance filter, or trailing stop.
}