{
  // Funding Reversion (Dao chieu sau Funding)
  "enabled": true,
  "openType": "ISOLATED",
  "positionMode": "HEDGE",
  "tradeSide": "short",
  "default": {
    "takeProfitPct": 1,
    "stopLossPct": 2,
    "bufferTime": "-150ms",
    "postSettleTimeout": "0.5s",
    "leverage": 6,
    "marginUSD": 5,
    "minVol24USD": 5000000,
    "minFundingRate": 0.8
  },
  "sync": {
    "time": "60s",
    "ticker": "300s",
    "contract": "3600s",
    "funding": "30s"
  },
  "safety": {
    "maxImpactRatio": 5,
    "maxLatency": "400ms", // Abort if RTT > 400ms
    "maxPriceDiffPercent": 0.8,
    "maxSymbolUSDTPrice": 50
  },
  "notifier": {
    "enable": true
  },
  "scanners": {
    "configured": false,
    "schedule": {
      "mexc": true,
      "binance": true,
      "bybit": true,
      "kucoin": true,
      "okx": true,
      "gate": true,
      "toobit": true,
      "bitmart": true
    }
  },
  "exchanges": {
    "mexc": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "-100ms", // Fire at T - (Latency/2 + Buffer) the bigger the earlier
      "postSettleTimeout": "0.5s" // Force close if reversion lifecycle does not terminally close
    },
    "bybit": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "-150ms",
      "postSettleTimeout": "0.5s"
    },
    "binance": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "-200ms",
      "postSettleTimeout": "0.5s"
    },
    "kucoin": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "-200s",
      "postSettleTimeout": "0.5s"
    },
    "okx": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "0ms",
      "postSettleTimeout": "0.5s",
      "minVol24USD": 1000000,
      "minFundingRate": 0.3
    },
    "gate": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "-150ms",
      "postSettleTimeout": "0.5s"
    },
    "toobit": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "200ms",
      "postSettleTimeout": "0.5s",
      "minVol24USD": 1000000,
      "minFundingRate": 0.3,
      "leverage": 3,
      "marginUSD": 5,
    },
    "bitmart": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "30ms",
      "postSettleTimeout": "0.5s",
      "minVol24USD": 1000000,
      "minFundingRate": 0.3,
      "leverage": 3,
      "marginUSD": 5
    }
  }
  // Reversion exit is intentionally static: IOC entry with server-side TP/SL.
  // No dynamic pricing, orderbook wall cap, imbalance filter, or trailing stop.
}