{
  // Funding Reversion (Dao chieu sau Funding)
  "enabled": true,
  "maxLatency": "300ms", // Abort if RTT > 200ms
  "exchanges": {
    "mexc": {
      "takeProfitPct": 1.5,
      "stopLossPct": 3,
      "bufferTime": "-50", // Fire at T - (Latency/2 + Buffer) the bigger the earlier
      "postSettleTimeout": "300s" // Force close if reversion lifecycle does not terminally close
    },
    "bybit": {
      "takeProfitPct": 1.5,
      "stopLossPct": 3,
      "bufferTime": "-80ms",
      "postSettleTimeout": "300s"
    },
    "binance": {
      "takeProfitPct": 1.5,
      "stopLossPct": 3,
      "bufferTime": "-350ms",
      "postSettleTimeout": "300s"
    },
    "kucoin": {
      "takeProfitPct": 1.5,
      "stopLossPct": 3,
      "bufferTime": "-50ms",
      "postSettleTimeout": "300s"
    },
    "gate": {
      "takeProfitPct": 1.5,
      "stopLossPct": 3,
      "bufferTime": "30ms",
      "postSettleTimeout": "300s"
    },
    "okx": {
      "takeProfitPct": 1.5,
      "stopLossPct": 3,
      "bufferTime": "30ms",
      "postSettleTimeout": "300s"
    },
    "hyperliquid": {
      "takeProfitPct": 1.5,
      "stopLossPct": 3,
      "bufferTime": "30ms",
      "postSettleTimeout": "300s"
    },
    "bitget": {
      "takeProfitPct": 1.5,
      "stopLossPct": 3,
      "bufferTime": "30ms",
      "postSettleTimeout": "300s"
    },
    "bingx": {
      "takeProfitPct": 1.5,
      "stopLossPct": 3,
      "bufferTime": "30ms",
      "postSettleTimeout": "300s"
    },
  }
  // Reversion exit is intentionally static: IOC entry with server-side TP/SL.
  // No dynamic pricing, orderbook wall cap, imbalance filter, or trailing stop.
}