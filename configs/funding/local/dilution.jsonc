{
  // Background Volume Dilution Configuration (Zero-Fee Maker Ambient Strategy)
  // Generates continuous, non-intrusive PostOnly Maker orders on high-liquidity pairs (BTC/ETH).
  // Dilutes funding volume ratio down to < 15-20%, protecting account from surveillance flags.
  "enabled": false,
  "pollInterval": "2m",
  "exchanges": {
    "toobit_futures": {
      "enabled": true,
      "symbol": "COW-SWAP-USDT",
      "maxPositionUSD": 2000, // Max position $2,000 (Uses max 100 USDT total margin at 20x)
      "leverage": 5, // 20x leverage
      "marginUSD": 100, // 50 USDT margin per order (quỹ 100 USDT chạy tối đa 2 orders)
      "unfilledCancelTimeout": "1m", // 1 minute auto-cancel if order unfilled
      "positionCloseTimeout": "1m", // 1 minute max hold duration after fill before bailout
      "takeProfitPct": 0.2, // 0.2% Take Profit trigger
      "stopLossPct": 0.5, // 0.5% Stop Loss trigger
      "spreadOffsetTicks": 0 // Quote at tight BBO
    }
  }
}