{
  // Funding Reversion (Dao chieu sau Funding)
  "enabled": true,
  "openType": "ISOLATED",
  "positionMode": "HEDGE",
  "tradeSide": "both",
  "default": {
    "takeProfitPct": 1,
    "stopLossPct": 2,
    "bufferTime": "-150ms", // Fire at T - (Latency/2 + Buffer) the bigger the earlier
    "postSettleTimeout": "3s", // Force close if reversion lifecycle does not terminally close
    "leverage": 5,
    "marginUSD": 3,
    "minVol24USD": 1000000,
    "minFundingRate": 0,
    "maxCandidateTrade": 1
  },
  "sync": {
    "time": "60s",
    "ticker": "300s",
    "contract": "3600s",
    "funding": "30s"
  },
  "safety": {
    "maxImpactRatio": 5,
    "maxLatency": "400ms", // Abort if RTT > 400ms
    "maxPriceDiffPercent": 0.8,
    "maxSymbolUSDTPrice": 50
  },
  "notifier": {
    "enable": true
  },
  "scanners": {
    "configured": true,
    "schedule": {
      "mexc": false,
      "xt": false
    }
  },
  "exchanges": {
    "mexc": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "-150ms", // Fire at T - (Latency/2 + Buffer) the bigger the earlier
      "postSettleTimeout": "3s" // Force close if reversion lifecycle does not terminally close
      // "minVol24USD": 1000000,
      // "minFundingRate": 0.3
    },
    "bybit": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "-200ms",
      "postSettleTimeout": "300s"
    },
