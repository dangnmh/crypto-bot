{
  // Funding Reversion (Dao chieu sau Funding)
  "enabled": true,
  "openType": "ISOLATED",
  "positionMode": "HEDGE",
  "tradeSide": "both",
  "default": {
    "takeProfitPct": 1,
    "stopLossPct": 2,
    "bufferTime": "-150ms",
    "postSettleTimeout": "3s", // Force close if reversion lifecycle does not terminally close
    "leverage": 5,
    "marginUSD": 3,
    "minVol24USD": 1000000,
    "minFundingRate": 0,
    "maxCandidateTrade": 1,
    "maxMarginUSDOfCandidate": 1000,
    "scoringRateWeight": 1.0, // Points per 0.1% (0.001) absolute funding rate
    "scoringVolumeWeight": 0.5, // Points per 1M USDT 24h volume
    "maxVolumeScore": 5.0, // Max volume score cap (5.0 pts = equivalent of 10M USDT volume cap)
    "pnlTrailing": {
      "enabled": true,
      "dropPct": 10.0,
      "confirmTicks": 2
    },
    "dynamicTP": {
      "enabled": true,
      "tpMultiplier": 2.5,
      "minTakeProfitPct": 1.5,
      "maxTakeProfitPct": 7.0
    }
  },
  "sync": {
    "time": "60s",
    "ticker": "300s",
    "contract": "3600s",
    "funding": "30s"
  },
  "safety": {
    "maxImpactRatio": 5,
    "maxLatency": "400ms", // Abort if RTT > 400ms
    "maxPriceDiffPercent": 0.8,
    "maxSymbolUSDTPrice": 50
  },
  "notifier": {
    "enable": true
  },
  "statsReporter": {
    "enable": false
  },
  "priceTracker": {
    "enable": false
  },
  "scanners": {
    "configured": true,
    "schedule": {
      "mexc_futures": false,
      "toobit_futures": false
    }
  },
  "exchanges": {
    "mexc_futures": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "-52ms",
      "postSettleTimeout": "300s" // Force close if reversion lifecycle does not terminally close
      // "minVol24USD": 1000000,
      // "minFundingRate": 0.3
    },
    "bybit_futures": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "15ms",
      "postSettleTimeout": "300s"
    }
  }
}