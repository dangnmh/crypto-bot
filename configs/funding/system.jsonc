{
  // ══════════════════════════════════════════════════════════════
  // API — Kết nối MEXC Exchange
  // ══════════════════════════════════════════════════════════════
  "api": {
    "future": { "baseURL": "https://api.mexc.com" },
    "websocket": { "wsURL": "wss://contract.mexc.com/edge" },
  },

  // ══════════════════════════════════════════════════════════════
  // Sync — Tần suất đồng bộ dữ liệu
  // ══════════════════════════════════════════════════════════════
  "sync": {
    "time": "60s", // Đồng bộ đồng hồ local ↔ server (cho fire chính xác tại T-Nms)
    "ticker": "300s", // Refresh bảng giá tổng quan qua REST (WS bổ sung real-time)
    "contract": "3600s", // Refresh thông số hợp đồng (PriceUnit, MinVol, Fee — hiếm đổi)
    "funding": "10s", // Refresh FR per-symbol (cần tươi cho recheck tại T-2s)
  },

  // ══════════════════════════════════════════════════════════════
  // Logging
  // ══════════════════════════════════════════════════════════════
  "logging": {
    "level": "debug",
    "ws": { "ticker": true, "order": true, "position": true },
    "http": true,
  },

  // ══════════════════════════════════════════════════════════════
  // Safety — Ngưỡng bảo vệ hệ thống
  // ══════════════════════════════════════════════════════════════
  "safety": {
    "maxCapitalPctPerSymbol": 10, // Tối đa 10% tổng vốn cho 1 symbol
    "maxImpactRatio": 1, // Reject nếu position > 1% volume 24h
    "maxCycleNotionalUSDT": 30000, // Tổng Reversion + Trap notional tối đa trong cùng symbol + settle
    "maxCycleLossUSDT": 150, // Ước tính loss tối đa theo SL của các leg trong cycle
    "disableSymbolAfterCriticalCloseFailure": true
  },

  // ══════════════════════════════════════════════════════════════
  // Journal — Ghi chép chu kỳ giao dịch (Cycle Recording)
  // ══════════════════════════════════════════════════════════════
  "journal": {
    "enabled": true,
    "dir": "data/journal", // Output: data/journal/cycles-YYYY-MM-DD.jsonl
  },

  // ══════════════════════════════════════════════════════════════
  // Trading Defaults — Giá trị mặc định cho TẤT CẢ symbol
  // Mỗi field có thể override per-symbol trong funding.jsonc
  // ══════════════════════════════════════════════════════════════
  "tradingDefaults": {
    // ── 1. Entry Filter ──────────────────────────────────────────
    "minFundingRate": 0.3, // FR tối thiểu (%). < 0.3% → phí ăn hết lời → skip
    "maxPriceDiffPercent": 0.8, // Slippage tĩnh fallback (%)

    // ── 2. Position ──────────────────────────────────────────────
    "leverage": 5,
    "openType": "ISOLATED", // ISOLATED (an toàn) | CROSS (rủi ro cao)
    "positionMode": "HEDGE", // HEDGE (bắt buộc cho Straddle Trap) | ONE_WAY

    // Strategy defaults live in sibling files:
    // - reversion.jsonc -> tradingDefaults.fundingReversion
    // - trap.jsonc      -> tradingDefaults.fundingTrap
  },
}
