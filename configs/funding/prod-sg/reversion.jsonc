{
  // Funding Reversion (Dao chieu sau Funding)
  "enabled": true,
  "openType": "ISOLATED",
  "positionMode": "HEDGE",
  "tradeSide": "short",
  "default": {
    "takeProfitPct": 1,
    "stopLossPct": 2,
    "bufferTime": "0ms",
    "postSettleTimeout": "0.5s",
    "leverage": 6,
    "marginUSD": 5,
    "minVol24USD": 5000000,
    "minFundingRate": 0.7,
    "maxCandidateTrade": 1,
    "maxMarginUSDOfCandidate": 1000,
    "scoringRateWeight": 1.0, // Points per 0.1% (0.001) absolute funding rate
    "scoringVolumeWeight": 0.5, // Points per 1M USDT 24h volume
    "maxVolumeScore": 10.0, // Max volume score cap (10.0 pts = equivalent of 20M USDT volume cap)
    "pnlTrailing": {
      "enabled": true,
      "dropPct": 10.0,
      "confirmTicks": 2
    },
    "dynamicTP": {
      "enabled": true,
      "tpMultiplier": 2.5,
      "minTakeProfitPct": 1.5,
      "maxTakeProfitPct": 7.0
    }
  },
  "sync": {
    "time": "60s",
    "ticker": "300s",
    "contract": "3600s",
    "funding": "30s"
  },
  "safety": {
    "maxImpactRatio": 250,
    "maxLatency": "400ms", // Abort if RTT > 400ms
    "maxPriceDiffPercent": 0.8,
    "maxSymbolUSDTPrice": 100
  },
  "notifier": {
    "enable": true
  },
  "statsReporter": {
    "enable": false
  },
  "priceTracker": {
    "enable": false
  },
  "scanners": {
    "configured": false,
    "schedule": {
      "mexc_futures": true,
      "bybit_futures": true, // very high cancel rate,
      "toobit_futures": false,
      "bitget_futures": false, // negative pnl
      "deepcoin_futures": false, // exchange restricted
      "kucoin_futures": false, // negative pnl
      "bitmart_futures": false, // negative pnl
      "bitunix_futures": false, // exchange restricted
      "okx_futures": false, // no funding oppotunity
      "xt_futures": false, // negative pnl
      "gate_futures": false, // rare oppotunity, negative pnl,
      "binance_futures": false, // negative pnl,
      "orangex_futures": false, // negative pnl,
      "hotcoin_futures": false, // prevent trade at funding settle
      "weex_futures": false, // no funding oppotunity
      "aster_futures": false // negative pnl
    }
  },
  "exchanges": {
    "mexc_futures": {
      "takeProfitPct": 1.5,
      "stopLossPct": 2,
      "bufferTime": "130ms", // SG low-latency: arrives at T_settle + 150ms (matches immediately after settlement snapshot)
      "postSettleTimeout": "6s", // Force close if reversion lifecycle does not terminally close
      "minVol24USD": 1000000,
      "minFundingRate": 0.5,
      "leverage": 4,
      "marginUSD": 50,
      "maxCandidateTrade": 1
      // "minVol24USD": 6000000,
      // "minFundingRate": 0.6,
      // "leverage": 15,
      // "marginUSD": 1000,
      // "maxCandidateTrade": 2,
      // "maxMarginUSDOfCandidate": 700
    },
    "bybit_futures": {
      "takeProfitPct": 1.5,
      "stopLossPct": 2,
      "bufferTime": "-10ms", // -8ms paid funding fee
      "postSettleTimeout": "6s",
      "minVol24USD": 500000,
      "minFundingRate": 0.3,
      "marginUSD": 5,
      "leverage": 4
    },
    "toobit_futures": {
      "takeProfitPct": 1.5,
      "stopLossPct": 2,
      "bufferTime": "390ms", // 350ms dont pay funding fee, 400ms pays funding fee
      "postSettleTimeout": "0.5s",
      "minVol24USD": 7000000,
      "minFundingRate": 0.6,
      "leverage": 20,
      "marginUSD": 1400,
      "maxCandidateTrade": 3,
      "maxMarginUSDOfCandidate": 1000
    },
    "bitget_futures": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "-320ms", // -300ms pays funding fee
      "postSettleTimeout": "0.5s",
      "minFundingRate": 0.7,
      "leverage": 10,
      "marginUSD": 50
    },
    "deepcoin_futures": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "-20ms", // 0ms pays funding fee
      "postSettleTimeout": "0.5s",
      "minFundingRate": 0.7,
      "leverage": 20,
      "marginUSD": 100
    },
    "aster_futures": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "-80ms", // -50ms pays funding fee
      "postSettleTimeout": "0.5s",
      "minVol24USD": 2000000,
      "minFundingRate": 0.7,
      "leverage": 2,
      "marginUSD": 50
    },
    "binance_futures": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "-200ms", // -200ms fill bad price, -150ms pays funding fee
      "postSettleTimeout": "0.5s"
    },
    "kucoin_futures": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "-250ms", // -200ms pays funding fee
      "postSettleTimeout": "0.5s"
    },
    "okx_futures": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "0ms",
      "postSettleTimeout": "0.5s",
      "minVol24USD": 1000000,
      "minFundingRate": 0.3
    },
    "gate_futures": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "-150ms",
      "postSettleTimeout": "0.5s"
    },
    "bitmart_futures": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "-100ms", // -50ms pays funding fee
      "postSettleTimeout": "0.5s",
      "minVol24USD": 1000000,
      "minFundingRate": 0.3,
      "leverage": 3,
      "marginUSD": 5
    },
    "weex_futures": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "-200ms", // -150ms pays funding fee
      "postSettleTimeout": "0.5s",
      "minVol24USD": 1000000,
      "minFundingRate": 0.3,
      "leverage": 3,
      "marginUSD": 5
    },
    "bitunix_futures": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "250ms", // 200ms dont get funding fee, 300ms pays funding fee
      "postSettleTimeout": "0.5s"
    },
    "xt_futures": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "-550ms", // -500ms pays funding fee
      "postSettleTimeout": "0.5s",
      "minVol24USD": 1000000,
      "minFundingRate": 0.3,
      "leverage": 3,
      "marginUSD": 5
    },
    "orangex_futures": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "300ms", // 100ms dont pay funding fee, 250ms cancel high cancel rate
      "postSettleTimeout": "0.5s",
      "minVol24USD": 1000000,
      "minFundingRate": 0.3,
      "leverage": 3,
      "marginUSD": 5
    },
    "hotcoin_futures": {
      "takeProfitPct": 1,
      "stopLossPct": 2,
      "bufferTime": "0ms",
      "postSettleTimeout": "0.5s",
      "minVol24USD": 1000000,
      "minFundingRate": 0.3,
      "leverage": 8,
      "marginUSD": 5
    }
  }
  // Reversion exit is intentionally static: IOC entry with server-side TP/SL.
  // No dynamic pricing, orderbook wall cap, imbalance filter, or trailing stop.
}