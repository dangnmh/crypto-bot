{
  // Common Funding Reversion Configuration (Prod-SG)
  "enabled": true,
  "openType": "ISOLATED",
  "positionMode": "HEDGE",
  "tradeSide": "short",
  "default": {
    "takeProfitPct": 1,
    "stopLossPct": 2,
    "bufferTime": "0ms",
    "postSettleTimeout": "0.5s",
    "leverage": 6,
    "marginUSD": 5,
    "minVol24USD": 5000000,
    "minFundingRate": 0.7,
    "maxCandidateTrade": 1,
    "maxMarginUSDOfCandidate": 1000,
    "scoringRateWeight": 1.0, // Points per 0.1% (0.001) absolute funding rate
    "scoringVolumeWeight": 0.5, // Points per 1M USDT 24h volume
    "maxVolumeScore": 10.0, // Max volume score cap (10.0 pts = equivalent of 20M USDT volume cap)
    "pnlTrailing": {
      "enabled": true,
      "dropPct": 4.0,
      "confirmTicks": 2
    },
    "dynamicTP": {
      "enabled": true,
      "tpMultiplier": 2.5,
      "minTakeProfitPct": 1.5,
      "maxTakeProfitPct": 7.0
    }
  },
  "sync": {
    "time": "60s",
    "ticker": "300s",
    "contract": "3600s",
    "funding": "30s"
  },
  "safety": {
    "maxImpactRatio": 250,
    "maxLatency": "400ms", // Abort if RTT > 400ms
    "maxPriceDiffPercent": 0.8,
    "maxSymbolUSDTPrice": 100
  },
  "notifier": {
    "enable": true
  },
  "statsReporter": {
    "enable": false
  },
  "priceTracker": {
    "enable": false
  }
}
