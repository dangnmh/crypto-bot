# ==============================================================================
# crypto-bot — Terraform Secrets Variables
# Copy this file to 'terraform.tfvars' in the same directory and fill in values.
# IMPORTANT: Never commit 'terraform.tfvars' to Git (it is ignored by .gitignore).
# ==============================================================================


# Optional: Path to kubeconfig if not using default (~/.kube/config)
# kubeconfig_path = "~/.kube/config"

docker_image = "ghcr.io/dangnmh/crypto-bot:latest"

# grafana_password = "admin"
# vault_password   = "root"
# postgres_password = "postgres"

# Optional: Specific paths for each of the 6 bot configuration files
# config_path_system     = "../../configs/funding/prod/system.jsonc"
# config_path_exchange   = "../../configs/funding/prod/exchange.jsonc"
# config_path_funding    = "../../configs/funding/prod/funding.jsonc"
# config_path_blacklist  = "../../configs/funding/prod/blacklist.jsonc"
# config_path_reversion  = "../../configs/funding/prod/reversion.jsonc"
# config_path_obfuscator = "../../configs/funding/prod/obfuscator.jsonc"


